// az eredeti COLOR.VC-vel)

#define black       (0 0 0)
#define white       (1 1 1)
#define red         (1 0 0)
#define green       (0 1 0)
#define blue        (0 0 1)
#define yellow      (1 1 0)
#define cyan        (0 1 1)
#define magenta     (1 0 1)
#define orange      (1 0.5 0)
#define pink        (1 0.6 0.7)
#define brown       (0.55 0.33 0.14)
#define gold        (0.85 0.65 0.13)
#define silver      (0.75 0.75 0.75)
#define grey        (0.5 0.5 0.5)
#define gray        (0.5 0.5 0.5)
#define dark_grey   (0.25 0.25 0.25)
#define light_grey  (0.8 0.8 0.8)
#define sky_blue    (0.53 0.81 0.92)
#define navy        (0 0 0.5)
#define forest_green (0.13 0.55 0.13)
#define maroon      (0.5 0 0)
#define tan         (0.82 0.71 0.55)
#define ivory       (1 1 0.94)
